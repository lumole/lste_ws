<launch>
  <!-- 参数：允许从命令行覆盖相机话题和 RViz 配置 -->
  <arg name="image_topic" default="/kinect/hd/image_color_rect" />
  <arg name="detections_topic" default="/lste/detections" />
  <arg name="output_topic" default="/lste/det_vis_image" />
  <arg name="rviz_config" default="$(find lste_core)/rviz/lste_det_vis.rviz" />

  <!-- 检测可视化节点：订阅相机 + /lste/detections，发布叠加框后的图像 -->
  <node pkg="lste_core"
        type="lste_det_vis_node.py"
        name="lste_det_vis_node"
        output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="detections_topic" value="$(arg detections_topic)" />
    <param name="output_topic" value="$(arg output_topic)" />
  </node>

  <!-- RViz：直接加载预先保存好的配置文件 -->
  <node pkg="rviz"
        type="rviz"
        name="rviz_lste_det_vis"
        args="-d $(arg rviz_config)" />
</launch>

