<launch>
  <!-- 整体：启动 GP frontier 节点，用于在 PASS 状态下基于 GP 生成探索子目标 -->

  <!-- Access-Topo 配置 -->
  <arg name="access_topo_config" default="$(find lste_topo_access)/topo_tree/cfgs/access_topo.yaml"/>
  <arg name="access_topo_test_name" default="default_test"/>

  <!-- 启动的节点属于 lste_topo_access 功能包 -->
  <!-- pkg：包名；type：Python 脚本名；name：节点名；output="screen"：日志打印到终端 -->
  <node pkg="lste_topo_access"
        type="gp_subgoals_sim_topo.py"
        name="gp_subgoal"
        output="screen">

    <!-- 占据球面配置：oc_srfc_rds 为占据面半径（激光最大考虑距离，单位 m） -->
    <param name="oc_srfc_rds" value="5.0" />
    <!-- 点云下采样步长：每隔 pcl_skp 个角度方向保留一个，用于减小 GP 训练点数量 -->
    <param name="pcl_skp" value="3" />

    <!-- GP 相关参数：gp_nav_indpts_sz 为稀疏 GP 的诱导点数量，值越大越准但越慢 -->
    <param name="gp_nav_indpts_sz"   value="400" />
    <!-- gp_nav_var_thrshld 为方差阈值，用于从方差图中提取“高不确定性”frontier 区域 -->
    <param name="gp_nav_var_thrshld" value="0.03" />

    <!-- 代价函数参数：gap_k_dir 控制方向项权重（越大越偏向机器人前方） -->
    <param name="gap_k_dir"       value="4.0" />
    <!-- gap_k_dst 控制与全局目标距离项权重（越大越偏向靠近全局目标的 frontier） -->
    <param name="gap_k_dst"       value="5.0" />
    <!-- gp_nav_goal_dst 为子目标距离机器人中心的标称半径（导航点所在球面的半径，单位 m） -->
    <param name="gp_nav_goal_dst" value="5.0" />

    <!-- 可视化参数：gp_nav_var_viz 为在 RViz 中绘制方差/占据球壳的半径（单位 m） -->
    <param name="gp_nav_var_viz"     value="5.0" />
    <!-- gp_nav_var_img_viz 控制是否弹出方差二值图窗口用于调试阈值（true 打开，false 关闭） -->
    <param name="gp_nav_var_img_viz" value="false" />

    <!-- Access-Topo 配置文件与测试名 -->
    <param name="access_topo_config" value="$(arg access_topo_config)"/>
    <param name="test_name" value="$(arg access_topo_test_name)"/>

    <!-- 默认全局目标（odom 坐标系）
         注意：实际运行时，gp_subgoals_sim_topo.py 会在没有收到 /lste/final_goal 时，
         自动将全局目标重置为“起步位置正前方 10 m”。
         这里的参数仅作为初始占位。 -->
    <!-- gl_x：全局目标 x 坐标；gl_y：全局目标 y 坐标；gl_yaw：全局目标朝向（弧度） -->
    <param name="gl_x" value="0.0" />
    <param name="gl_y" value="0.0" />
    <param name="gl_yaw" value="0.0" />

  </node>

  <!-- Goal Manager：依据 state/frontier/detections 生成唯一的 /lste/final_goal -->
  <node pkg="lste_topo_access"
        type="lste_goal_manager.py"
        name="lste_goal_manager"
        output="screen">
    <param name="pass_period" value="1.0" />
    <param name="sus_c_period" value="1.0" />
    <param name="locked_period" value="1.0" />
    <param name="sus_a_period" value="2.0" />
    <param name="sus_b_period" value="2.0" />
    <param name="forward_dist" value="10.0" />
    <param name="frontier_topic" value="/lste/gp_frontier_dir" />
    <param name="depth_topic" value="/kinect/hd/image_depth_rect" />
    <param name="image_topic" value="/kinect/hd/image_color_rect" />
    <param name="use_depth" value="true" />
  </node>
</launch>
