export LSTE_WS="$PWD"
PATH_add "$LSTE_WS/scripts/bin"

if [[ -f /opt/ros/noetic/setup.bash ]]; then
  source /opt/ros/noetic/setup.bash
else
  log_error "ROS Noetic setup not found: /opt/ros/noetic/setup.bash"
fi

if [[ -f "$LSTE_WS/devel/setup.bash" ]]; then
  source "$LSTE_WS/devel/setup.bash"
else
  log_error "Workspace setup not found; build the workspace first: $LSTE_WS/devel/setup.bash"
fi
